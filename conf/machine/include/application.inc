# To support layered ipk generation

APPLICATION_LAYER_VERSION = "5.0.1"

APPLICATION_EXTENSION = "-application"
APPLICATION_LAYER_ARCH = "${MACHINE}${APPLICATION_EXTENSION}"
PACKAGE_EXTRA_ARCHS:append = " ${APPLICATION_LAYER_ARCH}"

APPLICATION_IPK_PATH ?= "${APPLICATION_LAYER_ARCH}/${APPLICATION_LAYER_VERSION}/ipks/${BUILD_VARIANT}"
APPLICATION_IPK_SERVER_PATH ?= "${RDK_ARTIFACTS_BASE_URL}/${APPLICATION_IPK_PATH}"

# To set the remote feeds
IPK_FEED_URIS += " \
                ${APPLICATION_LAYER_ARCH}##${APPLICATION_IPK_SERVER_PATH} "

OSS_LAYER_VERSION = "4.10.0"
APPLICATION_OSS = "${@get_oss_arch(d)}${APPLICATION_EXTENSION}"

PACKAGE_EXTRA_ARCHS:append = "${@ '' if '${APPLICATION_OSS}' == '${OSS_LAYER_ARCH}' else ' ${APPLICATION_OSS}'}"

OPKG_ARCH_PRIORITY:${APPLICATION_OSS} = "160"
OSS_MACHINE = "${@get_oss_machine(d)}"

APPLICATION_OSS_IPK_PATH ?= "${APPLICATION_OSS}/${OSS_LAYER_VERSION}/ipks/"
APPLICATION_OSS_IPK_SERVER_PATH ?= "${RDK_ARTIFACTS_BASE_URL}/${APPLICATION_OSS_IPK_PATH}"

IPK_FEED_URIS += " \
                ${APPLICATION_OSS}##${APPLICATION_OSS_IPK_SERVER_PATH} "
